{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "paths": {
      "@agent-sdk/*": ["./src/*"],
      "@agent-sdk": ["./src/index.ts"],
      "@agent-UI/*": ["./agent-UI/*"],
      "@agent-UI": ["./agent-UI/index.ts"],
      "@agent-type": ["./agent-type/index.ts"],
      "@agent-type/*": ["./agent-type/*"]
    }
  },
  "include": ["src", "demo", "agent-OS", "agent-UI", "agent-type", "extensions/git/agent", "extensions/file/agent", "extensions/dynamic-tool/agent", "vite-env.d.ts", "extensions/devops/ui/tools", "extensions/devops/ui/transport", "extensions/devops/ui/utils", "extensions/devops/ui/index.tsx", "extensions/devops/ui/api", "extensions/devops/ui/components", "extensions/devops/ui/store", "extensions/devops/ui/hooks"],
  "exclude": ["node_modules", "dist"]
}
