# Node version is managed via nodeenv (.nodeenv\Scripts\Activate.ps1)
# See .node-version for the required version.
#
# Visual Studio — our build scripts auto-detect via resolveVcInstallDir()
# and set VCINSTALLDIR, so node-gyp skips version matching.
# For direct pnpm rebuild / pnpm install, uncomment if needed:
msvs_version=2022
enable_thin_lto=false
electron_mirror=https://repo.huaweicloud.com/electron/
electron_config_cache=D:\workspace\demo\agent-sdk\.electron-cache
# gitproxy=http://localhost:7890  # 改用环境变量 HTTP_PROXY/HTTPS_PROXY