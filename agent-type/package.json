{
  "name": "@agent-type",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "import": "./index.ts",
      "default": "./index.ts"
    },
    "./services": {
      "types": "./services/index.ts",
      "import": "./services/index.ts",
      "default": "./services/index.ts"
    },
    "./app-services": {
      "types": "./app-services.ts",
      "import": "./app-services.ts",
      "default": "./app-services.ts"
    },
    "./*": {
      "types": "./*.ts",
      "import": "./*.ts",
      "default": "./*.ts"
    }
  }
}
