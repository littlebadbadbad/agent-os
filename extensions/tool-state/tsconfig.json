{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "../..",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "paths": {
      "@agent-type": ["../../agent-type/index.ts"],
      "@agent-type/*": ["../../agent-type/*"]
    }
  },
  "include": ["agent/**/*.ts", "ui/**/*.ts", "ui/**/*.tsx", "vite-env.d.ts"]
}
